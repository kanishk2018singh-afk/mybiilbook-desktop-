# Create desktop/.env from this file. These values are public web-app identifiers,
# but they must belong to the SAME Firebase project used by the Android app.
# Register a Web app in that Firebase project and copy its firebaseConfig values.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: set true only for a local, unauthenticated UI walkthrough.
# Preview Mode never reads or writes Firebase data. Keep false for the real desktop app.
VITE_DESKTOP_PREVIEW_MODE=false
